{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DataBaseContext": "Data Source=DataBase/DataBase.sqlite"
  },

  "JwtSettings": {
    "Key": "",
    // The Key is stored inside the 'secret.json' file.
    // To access the file: 
    // - Go in the 'Explorateur de solution'
    // - Click on 'GaucheOuDroiteBackEnd'
    // - Click on 'Gérer les données secrètes de l'utilisateur'
    "Issuer": "GaucheOuDroite",
    "Audience": "GaucheOuDroite_Client",
    "ExpiryMinutes": 60
  },

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7280"
      }
    }
  }
}