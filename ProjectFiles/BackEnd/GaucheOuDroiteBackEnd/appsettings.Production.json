{
  "JwtSettings": {
    "Key": "",
    // The key is provided through the JWT_KEY GitHub Secret in CI.
    // 
    // -------------------------
    // 
    // If the project is built and published, the server must know the JWT key.
    // If you build the project manually, put the key in "Key"; build the project and remove the key.
    // If it's automatic using the CD pipeline, the JWT key will be added automatically.
    // 
    // Unlike during project development, here we are required to display the JWT encryption key in plain text.
    // We are doing this in order to allow people who want to test the game, not to have to modify the project files (generate a key),
    // they will be able to directly launch the server and the client and test the game.
    // 
    // Even if we managed to make GitHub not see the key, a player could very well go and get the key directly from the game files.
    // 
    // Having this key visible isn’t necessarily a problem for this project.
    // Because if ever the project becomes a commercial project, a new key will be generated and will only be accessible to a real server, not the client.
    "Issuer": "GaucheOuDroite",
    "Audience": "GaucheOuDroite_Client",
    "ExpiryMinutes": 60
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:9000"
      }
    }
  }
}