  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Afin de d\xE9bloquer le niveau suivant, il faut terminer le niveau en
    cours.\r\n\r\nPlus vous r\xE9pondez rapidement, plus votre score sera \xE9lev\xE9.\r\nLa
    zone bleue dans la barre de temps au haut de l'\xE9cran durant un niveau, repr\xE9sente
    la p\xE9riode dans laquelle vous pouvez obtenir le score maximal pour cette question.\r\nLa
    zone grise, elle, repr\xE9sente la p\xE9riode durant laquelle votre score baisse
    progressivement.\r\n\r\nAfin d'obtenir 3 \xE9toiles sur tous les niveaux (sauf
    le dernier, o\xF9 il faut juste d\xE9passer un score pr\xE9cis), il vous faut
    atteindre le score maximal du niveau.\r\nIl est uniquement atteignable si vous
    effectuez uniquement des r\xE9ponses \"PARFAIT\".\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
